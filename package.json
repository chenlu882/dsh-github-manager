{
  "name": "@local/dsh-github-plugins",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "DSH sidebar manager for GitHub-installed plugins, external npm tools, Codex plugins, Git projects and source archives.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "github",
    "npm",
    "side-panel"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check scan-worker.js && node --check version.js",
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "version.js",
    "scan-worker.js",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
